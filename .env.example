# Copy this file to .env and replace placeholder values.
# Never commit real secrets.

# Shared
PROJECT_NAME=GhostWriter AI

# Backend secrets and services
LLM_PROVIDER=ollama
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
PEXELS_API_KEY=your-pexels-api-key-here
VISUAL_PROVIDER=unsplash
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DRY_RUN=true
DEBUG_CHAT=false
DATABASE_URL=postgresql+asyncpg://ghostwriter:replace-with-db-password@db:5432/ghostwriter
SECRET_KEY=replace-with-long-random-secret
JWT_SECRET_KEY=replace-with-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REDIS_URL=redis://redis:6379/0

# Backend app settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOCIAL_ANALYZER_PATH=/workspace/social_analyzer

# Docker PostgreSQL settings
POSTGRES_DB=ghostwriter
POSTGRES_USER=ghostwriter
POSTGRES_PASSWORD=replace-with-db-password

# Frontend
VITE_API_URL=http://localhost:8000

# Optional local AI provider used by social_analyzer and backend fallback
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ghostwriter-ai/0.1
